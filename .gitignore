# Retained, nonpersonal M09 loopback credentials; each run uses its own directory.
/Validation/Spikes/SafariMTLS/Local/m09-loopback.*/

# Disposable AS-01 entitlement exports and command-status files.
as01-*-entitlements.plist
as01-*-registration-exit-status
as01-*-command-status*

# Raw hardware/card research may contain personal or security-sensitive data.
Validation/private/
Validation/raw/
Validation/unredacted/

# ADR-008 local-only credential asset. Generated for authorized local builds; never publish.
Packages/DNIeCore/Sources/DNIeCore/Evidence/Credentials/Assets/generation2.json
